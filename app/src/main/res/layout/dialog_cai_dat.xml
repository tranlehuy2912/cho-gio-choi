<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:text="@string/cai_huong_dan"
            android:textColor="@color/chu_nhat"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cai_nhan_token"
            android:textColor="@color/chu"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/cai_o_token"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:maxLines="2"
            android:textColor="@color/chu"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cai_nhan_nhom"
            android:textColor="@color/chu"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edNhom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/cai_o_nhap"
            android:importantForAutofill="no"
            android:inputType="numberSigned"
            android:textColor="@color/chu"
            android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
