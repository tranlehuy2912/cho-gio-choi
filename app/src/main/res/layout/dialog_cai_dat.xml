<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:text="@string/cai_huong_dan"
            android:textColor="@color/chu_nhat"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cai_nhan_ma_nha"
            android:textColor="@color/chu"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edMaNha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/cai_o_ma_nha"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:maxLines="2"
            android:textColor="@color/chu"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cai_nhan_ma_ghep"
            android:textColor="@color/chu"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edMaGhep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/cai_o_ma_ghep"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="6"
            android:textColor="@color/chu"
            android:textSize="18sp" />

        <!-- Cho bao tinh hinh: dang cho tablet ket nap, hay go sai ma. Khong dung
             Toast vi hop thoai nay che gan het man hinh, Toast hien sau lung no. -->
        <TextView
            android:id="@+id/chuTinhHinh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/chu_nhat"
            android:textSize="15sp" />

        <!-- Truoc day o day co nut sua danh sach viec nha. Danh sach gio nam tren
             Firestore, dung chung voi Bang dieu khien, va Ba Huy sua ben do. Dong nay
             noi cho Ba Huy biet phai tim o dau, khoi mo may ba ra tim. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/viec_sua_o_bang"
            android:textColor="@color/chu_nhat"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
